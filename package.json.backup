{
  "name": "asset-inventory-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/app",
    "packages/server"
  ],
  "main": "packages/app/index.js",
  "scripts": {
    "start:app": "npm start --prefix packages/app",
    "start:server": "npm run dev --prefix packages/server",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/mssql": "^9.1.8",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "^2.11.1",
    "cors": "^2.8.5",
    "pg": "^8.16.3",
    "prisma": "^6.19.0",
    "expo": "~54.0.21",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
