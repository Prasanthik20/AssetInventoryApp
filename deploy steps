# On Windows (PowerShell):
cd packages/server
.\deploy.ps1

# On Linux/macOS (Bash):
cd packages/server && \
npm run build && \
rm -rf deploy_exact && \
mkdir -p deploy_exact/.next && \
cp .next/standalone/packages/server/server.js deploy_exact/ && \
cp .next/standalone/packages/server/package.json deploy_exact/ && \
cp -r .next/standalone/node_modules deploy_exact/ && \
cp -r .next/standalone/packages/server/node_modules/. deploy_exact/node_modules/ && \
cp -r .next/static deploy_exact/.next/static && \
cp -r public/. deploy_exact/public/ && \
cd deploy_exact && \
zip -r ../deploy.zip . && \
cd .. && \
az webapp deploy --name asq-asset-api --resource-group asquaretechrg --src-path deploy.zip --type zip


