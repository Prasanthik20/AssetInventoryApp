generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("AZURE_DATABASE_URL")
}

model Tenants {
  id               String   @id @default(uuid())
  name             String
  organizationType String?
  institutionId    String?
  gstNumber        String?
  address          String?
  country          String?
  state            String?
  city             String?
  postalCode       String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users             Users[]
  subscriptions     Subscriptions[]
  Asset_Details     Asset_Details[]
  Category          Category[]
  Status            Status[]
  Asset_Assignments Asset_Assignments[]
  Notifications     Notifications[]
  AssetCategoryFields AssetCategoryFields[]
  
  // Custom Extensions for SaaS Tracking
  renewalRequests     RenewalRequests[]
  payments            Payments[]
  invoices            Invoices[]
  auditLogs           AuditLogs[]
  featureFlags        TenantFeatureFlags[]

  // Dynamic Roles & Workflows
  roles               Roles[]
  Approval_Workflows  Approval_Workflows[]
  Approval_Requests   Approval_Requests[]
}

model Plans {
  id        String   @id
  name      String
  minUsers  Int      @default(1) @map("min_users")
  maxUsers  Int
  minAssets Int      @default(1) @map("min_assets")
  maxAssets Int
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("INR")
  features  Json?
  createdAt DateTime @default(now())

  subscriptions Subscriptions[]
}

model Subscriptions {
  id                     String    @id @default(uuid())
  tenantId               String
  planId                 String
  startDate              DateTime  @default(now())
  endDate                DateTime?
  status                 String    @default("trialing")
  paymentProvider        String?
  providerSubscriptionId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenants @relation(fields: [tenantId], references: [id])
  plan   Plans   @relation(fields: [planId], references: [id])
}

model Roles {
  roleId                  BigInt                    @id @default(autoincrement()) @map("roleId")
  roleName                String?                   @map("roleName")
  tenantId                String?
  Users                   Users[]
  tenant                  Tenants?                  @relation(fields: [tenantId], references: [id])
  Role_Permissions        Role_Permissions[]
  Approval_Workflow_Steps Approval_Workflow_Steps[]
  Approval_Request_Steps  Approval_Request_Steps[]
}

model Users {
  userId                BigInt              @id @default(autoincrement()) @map("userId")
  employeeId            BigInt              @unique @default(autoincrement()) @map("employeeId")
  fullName              String?             @map("fullName")
  email                 String              @unique
  passwordHash          String              @map("passwordHash")
  phoneNumber           String?
  address               String?
  photoURL              String?             @map("photoURL")
  roleId                BigInt?             @map("roleId")
  tenantId              String?
  designation           String?
  isPrimaryContact      Boolean?            @default(false)
  status                String?             @default("active")
  resetToken            String?
  resetTokenExpiry      DateTime?           @db.Timestamp(6)
  reportingTo           BigInt?             @map("reportingTo")
  manager               Users?              @relation("DirectReports", fields: [reportingTo], references: [employeeId])
  reports               Users[]             @relation("DirectReports")
  operatorAssignments   Asset_Assignments[] @relation("OperatorAssignments")
  supervisorAssignments Asset_Assignments[] @relation("SupervisorAssignments")
  AssetsAssignedBy      Asset_Details[]     @relation("AssetsAssignedBy")
  AssetsAssignedTo      Asset_Details[]     @relation("AssetsAssignedTo")
  receivedNotifications Notifications[]     @relation("ReceivedNotifications")
  sentNotifications     Notifications[]     @relation("SentNotifications")
  role                  Roles?              @relation(fields: [roleId], references: [roleId])
  tenant                Tenants?            @relation(fields: [tenantId], references: [id])
  requestedRequests     Approval_Requests[] @relation("RequestedBy")
  actionedRequestSteps  Approval_Request_Steps[] @relation("ActionedBy")
}

model Category {
  id               BigInt             @id @default(autoincrement())
  categoryId       BigInt             @unique @map("categoryId")
  tenantId         String?
  category         String?
  serial_no        String             @unique
  parentCategoryId BigInt?
  isCustom         Boolean            @default(false)
  isSystemCategory Boolean            @default(false)
  Asset_Details    Asset_Details[]
  Category_Details Category_Details[]
  AssetCategoryFields AssetCategoryFields[]
  tenant           Tenants?           @relation(fields: [tenantId], references: [id])
}

model Category_Details {
  id            BigInt         @id(map: "Category_Details_pkey1") @default(autoincrement())
  categoryId    BigInt
  name          String
  asset_Id      String?        @unique
  Asset_Details Asset_Details? @relation(fields: [asset_Id], references: [asset_Id])
  category      Category       @relation(fields: [categoryId], references: [categoryId], map: "Category_Details_categoryId_fkey1")
}

model Status {
  id            BigInt          @id @default(autoincrement())
  tenantId      String?
  status        String
  Asset_Details Asset_Details[]
  tenant        Tenants?        @relation(fields: [tenantId], references: [id])
}

model Asset_Details {
  id               BigInt              @id @unique @default(autoincrement())
  categoryId       BigInt
  tenantId         String?
  name             String
  asset_Id         String?             @unique(map: "Asset_Details_assetId_key")
  controller_key   String?             @map("controller_key")
  model_no         String?
  serial_no        String              @unique
  status_id        BigInt?
  assigned_by      BigInt?
  assigned_to      BigInt?
  warranty_expiry  DateTime?           @db.Date
  purchase_date    DateTime?           @db.Date
  price            String?
  useful_life      Int?                @default(5)
  salvage_value    String?
  location         String?
  photoURL         String?
  barcodeURL       String?
  assignments      Asset_Assignments[]
  assignedByUser   Users?              @relation("AssetsAssignedBy", fields: [assigned_by], references: [employeeId])
  assignedToUser   Users?              @relation("AssetsAssignedTo", fields: [assigned_to], references: [employeeId])
  status           Status?             @relation(fields: [status_id], references: [id])
  category         Category            @relation(fields: [categoryId], references: [categoryId], map: "Category_Details_categoryId_fkey")
  Category_Details Category_Details?
  notifications    Notifications[]
  tenant           Tenants?            @relation(fields: [tenantId], references: [id])
  AssetDynamicValues AssetDynamicValues[]
  Approval_Requests  Approval_Requests[]
}

model Asset_Assignments {
  id                    BigInt          @id @default(autoincrement())
  assetId               BigInt
  tenantId              String?
  operator_employeeId   BigInt
  supervisor_employeeId BigInt
  projectName           String?
  location              String?
  assigned_date         DateTime?       @db.Date
  expected_return_date  DateTime?       @db.Date
  returned_date         DateTime?       @db.Timestamp
  notes                 String?
  photoURL              String?
  barcodeURL            String?
  status                String          @default("assigned")
  serialNoVerified      Boolean?
  createdAt             DateTime        @default(now())
  asset                 Asset_Details   @relation(fields: [assetId], references: [id])
  operator              Users           @relation("OperatorAssignments", fields: [operator_employeeId], references: [employeeId])
  supervisor            Users           @relation("SupervisorAssignments", fields: [supervisor_employeeId], references: [employeeId])
  notifications         Notifications[]
  tenant                Tenants?        @relation(fields: [tenantId], references: [id])
}

model Notifications {
  id           BigInt             @id @default(autoincrement())
  assetId      BigInt
  tenantId     String?
  assignmentId BigInt?
  reply        String?
  senderId     BigInt
  receiverId   BigInt
  reason       String
  status       String             @default("unread")
  createdAt    DateTime           @default(now()) @map("created_at")
  asset        Asset_Details      @relation(fields: [assetId], references: [id])
  assignment   Asset_Assignments? @relation(fields: [assignmentId], references: [id])
  receiver     Users              @relation("ReceivedNotifications", fields: [receiverId], references: [employeeId])
  sender       Users              @relation("SentNotifications", fields: [senderId], references: [employeeId])
  tenant       Tenants?           @relation(fields: [tenantId], references: [id])
}

model AssetCategoryFields {
  id               BigInt               @id @default(autoincrement())
  tenantId         String
  categoryId       BigInt
  fieldName        String
  fieldType        String
  isRequired       Boolean              @default(false)
  validationRules  String?
  category         Category             @relation(fields: [categoryId], references: [categoryId])
  tenant           Tenants              @relation(fields: [tenantId], references: [id])
  AssetDynamicValues AssetDynamicValues[]
}

model AssetDynamicValues {
  id               BigInt               @id @default(autoincrement())
  assetId          BigInt
  fieldId          BigInt
  value            String?
  asset            Asset_Details        @relation(fields: [assetId], references: [id])
  field            AssetCategoryFields  @relation(fields: [fieldId], references: [id])
}

// ==========================================
// Billing & Renewal Workflows
// ==========================================

model RenewalRequests {
  id             String    @id @default(uuid())
  tenantId       String
  planId         String
  requestedDate  DateTime  @default(now())
  transactionId  String    @unique
  paymentProofUrl String
  remarks        String?
  status         String    @default("submitted") // "submitted", "reviewing", "approved", "rejected"
  rejectionReason String?
  reviewedBy     String?   // SuperAdmin User ID
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenants @relation(fields: [tenantId], references: [id])
  
  @@index([tenantId])
  @@index([status])
}

model Payments {
  id            String   @id @default(uuid())
  tenantId      String
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  status        String   @default("completed") // "pending", "completed", "failed", "refunded"
  paymentMethod String   // "bank_transfer", "upi", "card"
  transactionId String   @unique
  paymentDate   DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant Tenants @relation(fields: [tenantId], references: [id])
  
  @@index([tenantId])
}

model Invoices {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceNo   String   @unique // Auto-generated "INV-YYYY-XXXX"
  amount      Decimal  @db.Decimal(10, 2)
  tax         Decimal  @db.Decimal(10, 2) @default(0)
  total       Decimal  @db.Decimal(10, 2)
  status      String   @default("paid") // "unpaid", "paid", "voided"
  dueDate     DateTime
  paidDate    DateTime?
  pdfUrl      String?
  createdAt   DateTime @default(now())

  tenant Tenants @relation(fields: [tenantId], references: [id])
  
  @@index([tenantId])
}

// ==========================================
// System Governance & Customizations
// ==========================================

model TenantFeatureFlags {
  id          String   @id @default(uuid())
  tenantId    String
  featureKey  String   // "barcodes", "custom_categories", "sso", "dynamic_fields"
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  tenant Tenants @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureKey])
}

model AuditLogs {
  id         String   @id @default(uuid())
  tenantId   String
  userId     BigInt
  action     String   // "CREATE_ASSET", "LOGIN", "EXPORT_EXCEL", "RENEWAL_REQUEST"
  entityName String   // "Asset_Details", "Subscriptions"
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenants @relation(fields: [tenantId], references: [id])
  
  @@index([tenantId, createdAt])
}

model SupportTickets {
  id          String   @id @default(uuid())
  tenantId    String
  userId      BigInt
  subject     String
  description String
  priority    String   @default("medium") // "low", "medium", "high", "critical"
  status      String   @default("open") // "open", "in_progress", "resolved", "closed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  messages    SupportTicketMessages[]

  @@index([tenantId])
  @@index([status])
}

model SupportTicketMessages {
  id          String   @id @default(uuid())
  ticketId    String
  senderId    BigInt   // ID of User sending message
  isAgent     Boolean  @default(false) // True if sent by SuperAdmin
  message     String
  createdAt   DateTime @default(now())

  ticket SupportTickets @relation(fields: [ticketId], references: [id])
}

model Permissions {
  id    BigInt             @id @default(autoincrement())
  code  String             @unique
  name  String
  roles Role_Permissions[]
}

model Role_Permissions {
  roleId       BigInt
  permissionId BigInt
  role         Roles       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Approval_Workflows {
  id         BigInt                    @id @default(autoincrement())
  tenantId   String
  name       String
  actionType String                    // "CHECKOUT" or "RETURN"
  isActive   Boolean                   @default(true)
  tenant     Tenants                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps      Approval_Workflow_Steps[]
  requests   Approval_Requests[]
}

model Approval_Workflow_Steps {
  id             BigInt             @id @default(autoincrement())
  workflowId     BigInt
  stepSequence   Int
  approverRoleId BigInt
  workflow       Approval_Workflows @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole   Roles              @relation(fields: [approverRoleId], references: [roleId], onDelete: Cascade)
}

model Approval_Requests {
  id                  BigInt                   @id @default(autoincrement())
  tenantId            String
  assetId             BigInt
  workflowId          BigInt
  currentStepSequence Int
  status              String                   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  requestedById       BigInt
  payload             Json                     // Stores info like project_name, location, expected_return_date, images
  createdAt           DateTime                 @db.Timestamp
  updatedAt           DateTime                 @db.Timestamp

  tenant              Tenants                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset               Asset_Details            @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow            Approval_Workflows       @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser     Users                    @relation("RequestedBy", fields: [requestedById], references: [employeeId], onDelete: NoAction, onUpdate: NoAction)
  steps               Approval_Request_Steps[]
}

model Approval_Request_Steps {
  id             BigInt            @id @default(autoincrement())
  requestId      BigInt
  stepSequence   Int
  approverRoleId BigInt
  status         String            @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  actionedById   BigInt?
  actionedAt     DateTime?         @db.Timestamp
  notes          String?
  mediaURL       String?
  request        Approval_Requests @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approverRole   Roles             @relation(fields: [approverRoleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
  actionedByUser Users?            @relation("ActionedBy", fields: [actionedById], references: [employeeId], onDelete: NoAction, onUpdate: NoAction)
}
