generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Roles {
  roleId   BigInt  @id @default(autoincrement()) @map("roleId")
  roleName String  @map("roleName")
  Users    Users[]
}

model Users {
  userId           BigInt          @id @default(autoincrement()) @map("userId")
  employeeId       BigInt          @unique @map("employeeId")
  fullName         String          @map("fullName")
  email            String          @unique
  passwordHash     String          @map("passwordHash")
  phoneNumebr      String?
  address          String?
  photoURL         String?         @map("photoURL")
  roleId           BigInt          @map("roleId")
  AssetsAssignedBy Asset_Details[] @relation("AssetsAssignedBy")
  AssetsAssignedTo Asset_Details[] @relation("AssetsAssignedTo")
  role             Roles           @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
}

model Category {
  id               BigInt             @id @default(autoincrement())
  categoryId       BigInt             @unique @map("categoryId")
  category         String?
  Asset_Details    Asset_Details[]
  Category_Details Category_Details[]
}

model Category_Details {
  id            BigInt         @id(map: "Category_Details_pkey1") @default(autoincrement())
  categoryId    BigInt
  name          String
  asset_Id      String?        @unique
  Asset_Details Asset_Details? @relation(fields: [asset_Id], references: [asset_Id], onDelete: NoAction, onUpdate: NoAction)
  category      Category       @relation(fields: [categoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction, map: "Category_Details_categoryId_fkey1")
}

model Status {
  id            BigInt          @id @default(autoincrement())
  status        String
  Asset_Details Asset_Details[]
}

model Asset_Details {
  id               BigInt            @id @unique @default(autoincrement())
  categoryId       BigInt
  name             String
  asset_Id         String?           @unique(map: "Asset_Details_assetId_key")
  model_no         String?
  serial_no        String?
  status_id        BigInt?
  assigned_by      BigInt?
  warranty_expiry  DateTime?         @db.Date
  purchase_date    DateTime?         @db.Date
  price            String?
  location         String?
  assigned_to      BigInt?
  assignedByUser   Users?            @relation("AssetsAssignedBy", fields: [assigned_by], references: [employeeId], onDelete: NoAction, onUpdate: NoAction)
  assignedToUser   Users?            @relation("AssetsAssignedTo", fields: [assigned_to], references: [employeeId], onDelete: NoAction, onUpdate: NoAction)
  status           Status?           @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category         Category          @relation(fields: [categoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction, map: "Category_Details_categoryId_fkey")
  Category_Details Category_Details?
}
