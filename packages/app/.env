# Frontend App Environment Configuration
# Copy to .env.local for development
 
# App Configuration
REACT_APP_APP_NAME=Asset Inventory
REACT_APP_VERSION=1.0.0
 
# API Configuration
# Development (local backend)
REACT_APP_API_URL=https://asq-asset-api-ckdtfzgqdggjcedv.southindia-01.azurewebsites.net/
 
# Production (Azure backend)
 REACT_APP_API_URL=https://asq-asset-api-ckdtfzgqdggjcedv.southindia-01.azurewebsites.net/
 
# Socket.IO (if using real-time features)
REACT_APP_WS_URL=https://asq-asset-api-ckdtfzgqdggjcedv.southindia-01.azurewebsites.net/
 
# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_NOTIFICATIONS=true
 
# Debugging
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info
 
 